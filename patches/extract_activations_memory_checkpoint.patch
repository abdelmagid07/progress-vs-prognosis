+def current_rss_mb():
+    """Current process resident memory in MB, via /proc/self/status (Linux only)."""
+    try:
+        with open("/proc/self/status") as f:
+            for line in f:
+                if line.startswith("VmRSS:"):
+                    kb = int(line.split()[1])
+                    return kb / 1024
+    except Exception:
+        pass
+    return float("nan")
+
+
+def checkpoint_path():
+    return CONSTRUCTION_DATA / "activation_means_checkpoint.pt"
+
+
+def load_checkpoint(n_layers):
+    path = checkpoint_path()
+    if not path.exists():
+        return {}, set()
+    print(f"Resuming from checkpoint: {path}", flush=True)
+    ckpt = torch.load(path, map_location="cpu", weights_only=False)
+    return ckpt["accum"], set(ckpt["processed_ids"])
+
+
+def save_checkpoint(accum, processed_ids):
+    path = checkpoint_path()
+    path.parent.mkdir(parents=True, exist_ok=True)  # original script only created this at the
+    # very end (right before its own final save); checkpointing fires much earlier and needs it
+    # to exist immediately, not just once at completion.
+    tmp_path = path.with_suffix(".tmp")
+    torch.save({"accum": accum, "processed_ids": sorted(processed_ids)}, tmp_path)
+    tmp_path.replace(path)  # atomic on POSIX
+
+
