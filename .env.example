# Copy to .env and fill in. .env is gitignored and must never be committed.

# Which request shape to use. vllm (default) | azure | openrouter.
# Selects configs/providers/<name>.yaml for the agent rollouts.
MODEL_PROVIDER=vllm

# OpenAI-compatible endpoint used for agent rollouts and for eliciting the
# model's verbalized P(success). Point this at a local vLLM server or any
# OpenAI-compatible provider serving Qwen3-32B.
#   vllm:  http://localhost:8000/v1
#   azure: https://<resource>.services.ai.azure.com/openai/v1
MODEL_API_BASE=
MODEL_API_KEY=

# litellm model id passed to mini-swe-agent.
#   vllm:  hosted_vllm/Qwen3-32B
#   azure: openai/<deployment>
MODEL_NAME=hosted_vllm/Qwen3-32B

# Only needed for `--provider openrouter` in prognosis.agent.confidence.
OPENROUTER_API_KEY=
